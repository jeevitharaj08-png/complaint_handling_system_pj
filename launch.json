{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch Complaint System",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/complaint_system.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: Build Complaint Handling System (GCC)"
        }
    ]
}
